	(text "ADIRS section board (v2). Switches, annunciator and backlight LEDs at their v1 coordinates.\nAnnunciator anodes on +5V_LED, cathodes down the ribbon to the TLC5927 outputs on the mainboard (no\nresistors: the TLC5927 sinks a set current). Backlight on +9V_BL, return switched on the mainboard.\nJ1 pinout as docs/board-split.md, to J701. Switch contacts: pin 1 to the ATmega, pin 2 common (GND), as v1."
		(exclude_from_sim no)
		(at 30.48 20.32 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left)
		)
		(uuid "46be5634-f89b-4dbd-803e-a6d8df2a5aaa")
	)
